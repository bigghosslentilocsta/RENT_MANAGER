# Example environment variables for backend (do NOT commit secrets to git)
# Copy this file to `.env` and fill values in your deployment environment.

# Server
PORT=5000
NODE_ENV=production

# MongoDB (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/rent_management

# CORS (comma-separated origins allowed in production)
ALLOWED_ORIGINS=http://yourdomain.com

# Vapi.ai credentials
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_assistant_id_here
VAPI_WEBHOOK_SECRET=change_this_to_secure_secret

# (Optional) Additional settings
LOG_LEVEL=info
# MongoDB Connection String (MongoDB Atlas)
MONGODB_URI=mongodb+srv://admin:<YOUR_PASSWORD>@healthcluster.p0oj6ri.mongodb.net/rent_management

# Server Port (default: 5000)
PORT=5000

# Environment mode (development or production)
NODE_ENV=development

# App login credentials used by /api/auth/login
APP_USERNAME=PUNNAM444
APP_PASSWORD=PUNNAM444

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vapi voice call settings for manual "Call Tenant" action
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Optional: secret for validating incoming webhook requests from Vapi
# If set, Vapi must be configured to include this value in the header
# `x-vapi-webhook-secret` on webhook requests.
VAPI_WEBHOOK_SECRET=
